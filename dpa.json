  "buy": [
    {"name": "入園後才能買", "text": "官方 FAQ 寫入園後才能在 App 裡買，在園外、開園前都不能用；英文 FAQ 也寫入園前不能買。App 要打開定位，不然有些功能用不了。", "src": "https://faq.tokyodisneyresort.jp/answer/67eaa6597605a4cb7775c039", "src_t": "官方 FAQ", "src2": "https://faq.tokyodisneyresort.jp/answer/67eaa65657951a27c885666c", "src2_t": "定位設定"},
    {"name": "一張門票買一人份", "text": "每張園區票券只能買 1 人份，不能多人共用。同行的人可以在 App 建群組，一次幫全部人的票買。3 歲以下的孩子，同行者有買就免費。", "src": "https://www.tokyodisneyresort.jp/tc/tdr/guide/app_service/disneypremieraccess.html", "src_t": "官方繁中頁"},
    {"name": "下一張什麼時候能買", "text": "買完 60 分鐘後，或那張的使用時間開始，兩個取比較早的，就能買其他設施的下一張。同一項設施要等用完或時間結束才能再買。設施和表演分開算，可以同時各有一張。", "src": "https://www.tokyodisneyresort.jp/tdr/guide/app_service/disneypremieraccess.html", "src_t": "官方日文頁", "src2": "https://faq.tokyodisneyresort.jp/answer/67eaa65b7605a4cb7775c099", "src2_t": "官方 FAQ"},
    {"name": "沒有 App 或沒有卡", "text": "可以到園內販售點買，收現金、電子錢包、信用卡（含簽帳金融卡、儲值卡）、迪士尼禮品卡。PayPay、Alipay 等條碼支付不能用。", "src": "https://faq.tokyodisneyresort.jp/answer/67eaa65938a1ebab2162dca6", "src_t": "官方 FAQ"},
    {"name": "會賣完", "text": "發行數量有限，賣完就沒有，有沒有剩要在 App 裡看。", "src": "https://www.tokyodisneyresort.jp/tc/tdr/guide/app_service/disneypremieraccess.html", "src_t": "官方繁中頁"}
  ],
  "pay": [
    {"name": "App 收哪些卡", "text": "日文 FAQ 列 JCB、VISA、Mastercard、AMEX、Diners 五種，另寫有這些標誌也有部分卡不能用。英文 FAQ 寫日本以外發行的卡收 JCB、VISA、Mastercard、AMEX 四種，沒有列 Diners。", "src": "https://faq.tokyodisneyresort.jp/answer/67eaa65838a1ebab2162dc6e", "src_t": "日文 FAQ", "src2": "https://faq-en.tokyodisneyresort.jp/answer/680ba04fd7820362f46c7d06", "src2_t": "英文 FAQ"},
    {"name": "卡要入園後才能綁", "text": "App 服務用的信用卡資料只能入園後、結帳時登錄或更換，入園前不能先設定。", "src": "https://faq.tokyodisneyresort.jp/answer/67eaa66038a1ebab2162dd1e", "src_t": "官方 FAQ"}
  ],
  "account": [
    {"name": "App 和帳號都是英文", "text": "繁中官網寫 App 是「英文版」，購買要先註冊 MyDisney Account（註冊頁只有英文）。註冊時居住地選「海外」，購買畫面就會是英文網站。", "src": "https://faq.tokyodisneyresort.jp/answer/6912b4104c2f21c5dfba0f0b", "src_t": "官方 FAQ"},
    {"name": "沒有手機的人", "text": "同行者的 App 可以掃你的園區票券二維條碼，幫你一起買；用的時候出示你自己的票券就好。", "src": "https://faq.tokyodisneyresort.jp/answer/67eaa656f939746b30956868", "src_t": "官方 FAQ"}
